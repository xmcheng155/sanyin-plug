#!/bin/sh /etc/rc.common

START=124
STOP=124
USE_PROCD=1
DEPEND=network

PROGRAM=/mnt/UDISK/sanyin-ssh/sanyin-sshd
AUTHORIZED_KEYS=/mnt/UDISK/sanyin-ssh/authorized_keys
HOST_KEY=/mnt/UDISK/sanyin-ssh/host-key

start_service() {
	attempt=0
	while { [ ! -x "$PROGRAM" ] || [ ! -s "$AUTHORIZED_KEYS" ]; } && [ "$attempt" -lt 30 ]; do
		attempt=$((attempt + 1))
		sleep 1
	done
	[ -x "$PROGRAM" ] || return 1
	[ -s "$AUTHORIZED_KEYS" ] || return 1
	mkdir -p /mnt/UDISK/sanyin-ssh
	chmod 0700 /mnt/UDISK/sanyin-ssh
	chmod 0600 "$AUTHORIZED_KEYS"

	procd_open_instance
	procd_set_param command "$PROGRAM" -listen 0.0.0.0:22 -authorized-keys "$AUTHORIZED_KEYS" -host-key "$HOST_KEY" -shell /bin/sh
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
